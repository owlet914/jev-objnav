# Copy to .env and edit for your machine. The project parser reads only the
# whitelisted keys below; it does not execute this file as shell code.
JEV_OBJ_WSL_DISTRO=Ubuntu-20.04
JEV_OBJ_BRIDGE_PYTHON=/opt/conda/envs/jev-obj-bridge/bin/python
JEV_OBJ_SIM_PYTHON=/opt/conda/envs/jev-obj-sim/bin/python
JEV_OBJ_BRIDGE_PORT=8766
JEV_OBJ_TRACE_DIR=.runtime/jev_region_graph/bridge
JEV_OPENROUTER_KEY_FILE=

